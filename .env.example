# ---------------------------------------------------------------------------
# Nyansa Marketplace — environment template
# Copy to .env.local and fill in. Never commit a filled-in copy.
# ---------------------------------------------------------------------------

# --- Core ------------------------------------------------------------------
NODE_ENV=development
APP_URL=http://localhost:3000
# 32+ char random string used to sign session cookies (openssl rand -base64 32)
SESSION_SECRET=

# --- Database (PostgreSQL 15+; Supabase, Neon, or self-hosted) --------------
# Pooled connection string used by the app at runtime.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/nyansa
# Direct (non-pooled) connection used by migrations. Falls back to DATABASE_URL.
DATABASE_URL_DIRECT=

# --- AI agents (Anthropic) -------------------------------------------------
# Required for the agent runtime. Without it, agent routes return a clear
# "not configured" error rather than failing at import time.
ANTHROPIC_API_KEY=
# Default model for all agents. Override per-agent in src/server/ai/registry.ts
ANTHROPIC_MODEL=claude-opus-5

# --- Payments (Paystack — cards + MTN MoMo / Telecel Cash / AT Money) -------
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_SECRET=

# --- FX rates --------------------------------------------------------------
# Base rates are seeded in the DB; this optional provider refreshes them.
FX_PROVIDER_URL=
FX_PROVIDER_KEY=
# Margin applied on top of the mid-market rate, in basis points (250 = 2.5%).
FX_SPREAD_BPS=250

# --- Feature flags ---------------------------------------------------------
FEATURE_ORDER_TO_SHIP=true
FEATURE_AI_CONCIERGE=true
FEATURE_VENDOR_PORTAL=true
